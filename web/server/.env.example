# Public HTTPS URL used in OTA manifests
PUBLIC_ORIGIN=https://sign.example.com
# GitHub Pages/PWA origin allowed by the gateway
WEB_ORIGIN=https://nightvibes33.github.io
# Protects /v1 endpoints; store the real value only in the deployment secret
API_TOKEN=replace-with-random-secret
# URL of the authorized macOS signing worker. Leave empty for local macOS worker mode.
SIGNER_URL=https://signer.example.com
# Local macOS worker mode only:
# SIGNING_IDENTITY=Apple Development: Your Name (TEAMID)
# PROVISION_PROFILE=/secure/path/profile.mobileprovision
UPLOAD_DIR=/tmp/sidestore-web
SIGNING_WORK_DIR=/tmp
PORT=8787
